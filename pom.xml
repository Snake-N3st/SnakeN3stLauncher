<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mc.snakenest.launcher</groupId>
    <artifactId>snaken3st-launcher-parent</artifactId>
    <!--
        NOT a product version: this only versions the shared build configuration below
        (plugin versions, compiler release, JUnit BOM). Each module carries its own,
        independent product version - see the properties block. Bumping this one means
        editing the <parent> block of all three modules, so it deliberately stays put
        unless the shared build setup itself changes in a breaking way.
    -->
    <version>2.0.0</version>
    <packaging>pom</packaging>

    <!--
        Two independently-distributed artifacts, each under its own license
        (see each module's own LICENSE file):
        - bootstrap: tiny, rarely-updated stub. No GPL dependencies, proprietary
          (All Rights Reserved). Downloads and runs the latest "launcher" jar
          published on the site.
        - launcher: the complete application. Embeds FlowUpdater/OpenLauncherLib
          (GPL-3.0), so the whole jar is GPL-3.0.
        - common: shared utilities used by both. GPL-3.0, since a compiled copy
          of it ends up embedded in launcher's GPL binary - but that doesn't
          force bootstrap (which never combines with GPL code) to be GPL too,
          since the copyright holder of common is free to license the same
          original source differently per product.
        Kept as a single reactor so both build with one `mvn package`, but each
        module's pom controls its own dependencies/packaging independently.
    -->
    <modules>
        <module>common</module>
        <module>bootstrap</module>
        <module>launcher</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.3</junit.version>

        <!--
            One product version per module, bumped independently - a launcher fix must not
            force a new bootstrap or common version (see VERSIONING.md for the MAJOR.MEDIUM.MINOR
            rules and why the series starts at 2.0.0).

            Each of these MUST match the literal <version> in the matching module's own pom.
            Maven can't read a property there reliably (a module's own version has to be a
            constant), so it's stated twice on purpose - the duplication is caught by the build
            itself: a mismatch makes the inter-module dependency unresolvable in the reactor
            rather than silently building against the wrong thing.
        -->
        <common.version>2.3.0</common.version>
        <bootstrap.version>2.4.1</bootstrap.version>
        <launcher.version>2.6.1</launcher.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- So the modules declare the dependency without repeating a version. -->
            <dependency>
                <groupId>mc.snakenest.launcher</groupId>
                <artifactId>common</artifactId>
                <version>${common.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
